NODE_ENV=development
PORT=5001

# MongoDB Atlas connection string; required for real user accounts, invitations, and reset tokens.
MONGODB_URI=

# Generate a random secret of at least 32 characters. Never commit the real value.
JWT_SECRET=

# Development-only demo account. These values are ignored unless NODE_ENV=development.
DEMO_AUTH_ENABLED=true
DEMO_ADMIN_EMAIL=admin@biet.ac.in
DEMO_ADMIN_PASSWORD=BietDemo@2026
DEMO_ADMIN_NAME=BIET Development Demo Administrator

# Comma-separated browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OFFICIAL_EMAIL_DOMAINS=biet.ac.in

# Explicitly authorized administrator email allowlist (e.g. approved Gmail or personal accounts)
AUTHORIZED_ADMIN_EMAILS=

# Optional one-time bootstrap administrator. Remove the password after first provisioning.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=BIET Administrator

# Resend email configuration for password-reset delivery.
RESEND_API_KEY=
EMAIL_FROM=
APP_BASE_URL=http://localhost:5173
