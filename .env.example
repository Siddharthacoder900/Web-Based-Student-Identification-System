NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/biet_student_identity
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
FRONTEND_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
# Set these only for the one-time `npm run create-admin` command:
# ADMIN_NAME=BIET Administrator
# ADMIN_EMAIL=admin@example.edu
# ADMIN_PASSWORD=use-a-unique-password-of-at-least-12-characters
